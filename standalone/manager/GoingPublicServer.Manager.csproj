<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- STANDALONE-1: the Going Public server without AMP - one program for Windows and Linux (and the Docker image):
       web interface with login, starts and watches the game, SteamCMD, Proton GE (Linux), settings, backups.
       dotnet publish -r linux-x64   /   dotnet publish -r win-x64   (self-contained, one file)
       standalone/build-packages.sh builds both and packs them with the server files. On Windows the access data
       appear in a window of their own (Win32Window.cs - plain Win32, no Windows Forms: builds on Linux). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>GoingPublicServer</AssemblyName>
    <RootNamespace>GpsManager</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.16</Version>
    <Product>Going Public Server</Product>
    <Company>amaus1209</Company>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" LogicalName="www/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
